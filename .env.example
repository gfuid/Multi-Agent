# Multi-Agent AI Configuration Template
# Copy this file to .env and fill in your private API keys

# 1. Tavily Search API Key (Free tier available at https://app.tavily.com)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# 2. Groq LLM API Key (Free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional: OpenAI API Key (if you wish to use OpenAI models)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
